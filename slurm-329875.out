 compute_horizontal_advection_of_w(
  horizontal_advection_of_w_at_edges_on_half_levels,
  w,
  tangential_wind_on_half_levels,
  vn_on_half_levels,
  c_intp,
  inv_dual_edge_length,
  inv_primal_edge_length,
  tangent_orientation,
  num_edges,
  horizontal_start,
  horizontal_end,
  vertical_start,
  vertical_end
) {
  horizontal_advection_of_w_at_edges_on_half_levels @ u⟨ Edgeₕ: [horizontal_start, horizontal_end[, Kᵥ: [vertical_start, vertical_end[ ⟩
       ← as_fieldop(
           λ(
             vn_on_half_levels,
             inv_dual_edge_length,
             w,
             tangential_wind_on_half_levels,
             inv_primal_edge_length,
             tangent_orientation,
             c_intp
           ) → 
             cast_(
               ·vn_on_half_levels × ·inv_dual_edge_length × (·⟪E2Cₒ, 0ₒ⟫(w) - ·⟪E2Cₒ, 1ₒ⟫(w))
               + ·tangential_wind_on_half_levels × ·inv_primal_edge_length × ·tangent_orientation
                 × (cast_(
                      cast_((λ(_step_3) → _step_3(_step_3(_step_3(_step_3(_step_3(_step_3(0, 0ₒ), 1ₒ), 2ₒ), 3ₒ), 4ₒ), 5ₒ))(
                              λ(_acc_1, _i_2) → 
                                (λ(_fuse_maps_1, _fuse_maps_3, _fuse_maps_4) → _fuse_maps_1 + _fuse_maps_3 × _fuse_maps_4)(
                                  _acc_1, ·⟪E2Vₒ, 0ₒ, V2Cₒ, _i_2⟫(w), list_get(_i_2, ·⟪E2Vₒ, 0ₒ⟫(c_intp))
                                )
                            ), float64), float64
                    )
                    - cast_(
                        cast_((λ(_step_6) → _step_6(_step_6(_step_6(_step_6(_step_6(_step_6(0, 0ₒ), 1ₒ), 2ₒ), 3ₒ), 4ₒ), 5ₒ))(
                                λ(_acc_4, _i_5) → 
                                  (λ(_fuse_maps_5, _fuse_maps_7, _fuse_maps_8) → _fuse_maps_5 + _fuse_maps_7 × _fuse_maps_8)(
                                    _acc_4, ·⟪E2Vₒ, 1ₒ, V2Cₒ, _i_5⟫(w), list_get(_i_5, ·⟪E2Vₒ, 1ₒ⟫(c_intp))
                                  )
                              ), float64), float64
                      )), float64
             ), u⟨ Edgeₕ: [horizontal_start, horizontal_end[, Kᵥ: [vertical_start, vertical_end[ ⟩
         )(vn_on_half_levels,
           inv_dual_edge_length,

             then ·⟪C2E2Cₒ, 0ₒ⟫(cell_input) + ·cell_input + ·cell_input + ·⟪C2E2Cₒ, 1ₒ⟫(cell_input) + ·cell_input
                  + ·⟪C2E2Cₒ, 2ₒ⟫(cell_input)
             else ·⟪C2E2Cₒ, 0ₒ⟫(cell_input) + ·cell_input + ·⟪C2E2Cₒ, 1ₒ⟫(cell_input) + ·cell_input
                  + ·⟪C2E2Cₒ, 2ₒ⟫(cell_input) + ·cell_input,
           u⟨ Cellₕ: [__cell_out_0_range[0], __cell_out_0_range[1][, Kᵥ: [__cell_out_1_range[0], __cell_out_1_range[1][ ⟩
         )(cell_input, index(Cellₕ), num_cells);
}
end
